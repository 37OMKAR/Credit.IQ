# Copy this file to .env and fill in what you have. Nothing here is required to start the app.

# --- AI engine (pick one; DeepSeek is the default in the app) ---
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LONGCAT_API_KEY=
# LONGCAT_MODEL=LongCat-2.0
# OPENROUTER_MODEL=deepseek/deepseek-chat
# GROQ_API_KEY=
# LLM_MODEL=deepseek-chat

# --- Optional extra news sources (Google News works without a key) ---
NEWSAPI_KEY=
GNEWS_KEY=

# --- Optional: sanctions / PEP screening (api.opensanctions.org) ---
OPENSANCTIONS_API_KEY=

# --- Optional: where the central database lives (default data/central.db) ---
# CREDITINTEL_DB=
# USD_INR=88

# --- Report defaults ---
OFFICER_NAME=
BRANCH_NAME=
